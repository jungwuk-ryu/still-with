NEXT_PUBLIC_APP_URL=https://cmuxaim.jungwuk.com

# Optional local defaults. Relative paths resolve from the project root.
SQLITE_PATH=./data/still-with.sqlite
LOCAL_STORAGE_DIR=./data/uploads
STORAGE_URL_SECRET=replace-with-a-stable-local-secret

# Required only when the matching provider adapter is called.
OPENAI_API_KEY=
WORLDLABS_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Optional pet video fidelity. Defaults favor high-resolution demo output.
VEO_VIDEO_RESOLUTION=1080p

# Optional. Defaults to gpt-5.4 when OPENAI_API_KEY is set.
# Set to gemini-3.1-pro to use GEMINI_API_KEY for audio prompt planning.
AUDIO_PROMPT_MODEL=

# Required to email users when a memory space finishes loading.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Still With <memories@example.com>"

# Optional future fallback key.
# SEEDANCE_API_KEY=
